# =============================================================================
# Evocation Platform — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in values. NEVER commit .env to version control.
# All values below are examples only. Replace with real values for production.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
# Options: development, staging, production
APP_SECRET_KEY=CHANGE-ME-generate-a-64-char-random-string
APP_DEBUG=true

# Public-facing hostnames (no trailing slash)
PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://evocation:evocation_dev@localhost:5432/evocation
# For Alembic (sync driver)
DATABASE_URL_SYNC=postgresql://evocation:evocation_dev@localhost:5432/evocation

# -----------------------------------------------------------------------------
# Redis (optional, for rate limiting / caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE-ME-generate-another-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session cookie settings
SESSION_COOKIE_DOMAIN=localhost
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Password hashing
PASSWORD_HASH_ROUNDS=12

# -----------------------------------------------------------------------------
# Cloudflare DNS
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=CHANGE-ME-your-cloudflare-api-token
# Comma-separated zone configurations: zone_id:parent_domain
# Example: abc123:example.com,def456:example.org
CLOUDFLARE_ZONES=CHANGE-ME-zone-id:example.com
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4

# -----------------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGE-ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE-ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE-ME
STRIPE_CURRENCY=inr

# Payment provider mode: stripe, test
PAYMENT_PROVIDER=test

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Provider: smtp, sendgrid, ses, console (dev only)
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Evocation

# SMTP settings (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE-ME
SMTP_PASSWORD=CHANGE-ME
SMTP_USE_TLS=true

# SendGrid (when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=CHANGE-ME

# -----------------------------------------------------------------------------
# Wallet Configuration
# -----------------------------------------------------------------------------
WALLET_MIN_TOPUP_PAISE=6000
WALLET_MAX_TOPUP_PAISE=100000
WALLET_FIRST_FUNDING_MIN_PAISE=6000

# -----------------------------------------------------------------------------
# Subscription / Rental Configuration
# -----------------------------------------------------------------------------
GRACE_PERIOD_DAYS=5
RENAME_COOLDOWN_HOURS=24
CHECKOUT_RESERVATION_MINUTES=15

# -----------------------------------------------------------------------------
# Background Jobs
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=true
EXPIRY_CHECK_INTERVAL_MINUTES=60
RENEWAL_CHECK_INTERVAL_MINUTES=60

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=CHANGE-ME-use-strong-password

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=CHANGE-ME-for-encrypted-backups
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
